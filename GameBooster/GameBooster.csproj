<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameBooster</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Game Booster</Authors>
    <Description>Optimizador de rendimiento para juegos</Description>
    <ApplicationIcon>game.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="game.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.*" />
    <PackageReference Include="System.Management" Version="8.0.*" />
  </ItemGroup>

</Project>